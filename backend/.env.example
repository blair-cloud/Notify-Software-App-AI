# Application
APP_NAME=Notify
ENVIRONMENT=development
DEBUG=true
PORT=8000

# Security
SECRET_KEY=notify_super_secret_jwt_key_change_in_production_32bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Supabase / PostgreSQL Database
DATABASE_URL=postgresql+asyncpg://postgres:your_supabase_password@db.your_supabase_project.supabase.co:5432/postgres
SUPABASE_URL=https://your_project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Supabase Storage Buckets
STORAGE_DOCUMENTS_BUCKET=notify-documents
STORAGE_AVATARS_BUCKET=notify-avatars
STORAGE_PROPERTY_IMAGES_BUCKET=notify-property-images

# Email / SMS Services
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@notify.co.rw
SMTP_PASSWORD=your_smtp_password
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=+250788000000
