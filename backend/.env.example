# =============================================================================
# NOTIFY - BACKEND ENVIRONMENT
# =============================================================================
# Identity  : Supabase Auth
# Database  : Supabase PostgreSQL
# This file is committed, so it must only ever contain placeholders.
# =============================================================================

# Application
APP_NAME=Notify
ENVIRONMENT=development
DEBUG=true
PORT=8000

# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co

# Publishable. Safe in a browser bundle; useless without a session because RLS
# denies the `anon` role everything.
SUPABASE_ANON_KEY=<anon-key>

# SERVER-SIDE ONLY. Bypasses Row Level Security entirely and can mint a session
# for any account - it must never reach the frontend or a git commit.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Only needed for projects still using legacy symmetric (HS256) signing keys.
# Modern projects publish a JWKS and tokens verify with no secret at all.
# SUPABASE_JWT_SECRET=

# -----------------------------------------------------------------------------
# Database - Supabase PostgreSQL (required)
# -----------------------------------------------------------------------------
# From: Project Settings -> Database -> Connection string -> URI, with the
# scheme changed to postgresql+asyncpg://
#
# There is no SQLite fallback. The app refuses to start on anything else rather
# than silently writing to a database nobody is looking at.
#
# Port 5432 = session pooler (recommended). Port 6543 = transaction pooler,
# which the app detects and configures asyncpg for automatically.
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Schema is applied once from supabase_v2_migration.sql in the SQL editor.
# The application never creates or alters tables.

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# No longer signs sessions (Supabase Auth does) - it HMACs invitation tokens.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=<GENERATE_A_LONG_RANDOM_VALUE>

# Comma-separated allowed browser origins. Empty = permissive wildcard for
# development; set it in production, which also enables credentialed CORS.
# Known Firebase hosts (notifyappo.web.app, notify-c2d43.web.app) are always
# allowed in addition to this list.
CORS_ORIGINS=

# Where the browser app is served from. Supabase redirects confirmation and
# password-reset links back here, so it must also be listed under
# Authentication -> URL Configuration -> Redirect URLs in the dashboard.
# Production: https://notifyappo.web.app
FRONTEND_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Storage buckets
# -----------------------------------------------------------------------------
STORAGE_DOCUMENTS_BUCKET=notify-documents
STORAGE_AVATARS_BUCKET=notify-avatars
STORAGE_PROPERTY_IMAGES_BUCKET=notify-property-images

# -----------------------------------------------------------------------------
# Outbound channels
# -----------------------------------------------------------------------------
# Account email (confirmation, password reset) is sent by Supabase Auth, not by
# this backend. These are for rent reminders and notices only, and stay in
# simulated mode - logged, never sent - until a provider is configured.
SMS_PROVIDER=
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=

WHATSAPP_PROVIDER=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_TOKEN=

# Brevo SMTP. Credentials come from Brevo -> SMTP & API -> SMTP; the password
# is a generated SMTP *key*, not the account password, and the login normally
# looks like 9xxxxx001@smtp-brevo.com. Port 2525 also works if 587 is blocked.
#
# EMAIL_PROVIDER is optional - a complete SMTP block is enough to switch real
# sending on. Leave the password unset to keep the simulated mode, in which
# messages are logged rather than silently dropped.
EMAIL_PROVIDER=
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=<your-brevo-smtp-login>
SMTP_PASSWORD=<your-brevo-smtp-key>

# Must be a verified sender or domain in Brevo, or it rejects the message.
EMAIL_FROM=no-reply@notify.rw
EMAIL_FROM_NAME=Notify Kigali

# Verify with: python -m backend.scripts.test_email you@example.com

TRANSLATION_PROVIDER=
LIBRETRANSLATE_URL=https://libretranslate.com/translate
LIBRETRANSLATE_API_KEY=
